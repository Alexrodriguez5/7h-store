# Copia este archivo a .env.local (Next.js) y a .env (Prisma CLI) con los MISMOS valores.
# Nunca subas .env ni .env.local a GitHub.

# --- Base de datos (Supabase → Connect → Session pooler) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# --- Sitio ---
# En producción: tu dominio con https (se usa en correos, sitemap, SEO y verificación de origen).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Panel /admin ---
# Firma de las sesiones: 32+ caracteres aleatorios. OBLIGATORIA en producción.
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
ADMIN_SESSION_SECRET=
# Llave de arranque: SOLO sirve para crear el primer dueño en /admin/setup. Después ya no da acceso.
ADMIN_PASSWORD="cambia-esta-llave-de-arranque"

# --- Wompi (Sandbox mientras pruebas; producción solo cuando tú lo decidas) ---
WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxx"
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxx"
WOMPI_INTEGRITY_SECRET="test_integrity_xxxxxxxxx"
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxx"

# --- Cron de expiración de pedidos (Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET="cambia-este-secreto"

# --- Supabase Storage (imágenes). Solo servidor: NUNCA con prefijo NEXT_PUBLIC_ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo transaccional (opcional, para recuperar contraseñas del panel) ---
# Cuenta en https://resend.com con tu dominio verificado.
RESEND_API_KEY=
EMAIL_FROM="7H STORE <no-responder@tudominio.com>"
# Buzón de atención al cliente (recibe avisos de solicitudes). Si falta, se usa NEXT_PUBLIC_BUSINESS_EMAIL.
SUPPORT_INBOX_EMAIL="soporte@tudominio.com"
# Correo entrante (Resend → Webhooks → email.received → <sitio>/api/webhooks/correo-entrante). Secreto "whsec_…".
RESEND_WEBHOOK_SECRET=

# ── Inicio de sesión con Google (opcional) ──
# Google Cloud Console → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizada: <sitio>/api/cuenta/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Datos bancarios para transferencia/consignación ---
BANK_NAME="Bancolombia"
BANK_ACCOUNT="00000000000"
BANK_ACCOUNT_TYPE="Ahorros"
BANK_HOLDER="7H STORE"
BANK_DOCUMENT="900000000"

# --- Datos del negocio (públicos: se muestran en Contacto, Términos, Privacidad y Envíos) ---
# Déjalos vacíos hasta tenerlos CONFIRMADOS: la tienda mostrará "[Pendiente: …]" en lugar de inventarlos.
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_TAX_ID=
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_EMAIL=
# WhatsApp con indicativo y sin "+" ni espacios, p. ej. 573001234567
NEXT_PUBLIC_BUSINESS_WHATSAPP=
# p. ej. "3 a 7 días hábiles"
NEXT_PUBLIC_SHIPPING_TIME=
# p. ej. "1 de noviembre de 2026"
NEXT_PUBLIC_LEGAL_UPDATED=

# --- Envia.com: guías automáticas y tarifas reales (solo servidor) ---
# Token: shipping-test.envia.com → Desarrolladores → API Keys (sandbox). En producción: shipping.envia.com.
ENVIA_API_TOKEN=
# "sandbox" (por defecto) o "production". Cada token solo funciona en su ambiente.
ENVIA_ENV=sandbox
# Transportadoras a cotizar, separadas por coma.
ENVIA_CARRIERS=servientrega,coordinadora
# "1" = el checkout cobra la tarifa real más barata de Envia; vacío = tarifas por zona del panel.
ENVIA_CHECKOUT_RATES=

# ── AURA (asistente con IA) · Google Gemini, NIVEL GRATUITO ──
# La clave se crea en Google AI Studio en un proyecto SIN facturación. Solo servidor: nunca NEXT_PUBLIC.
GEMINI_API_KEY=
# Solo se aceptan modelos con nivel gratuito verificado; cualquier otro valor deja AURA apagada.
GEMINI_MODEL=gemini-3.8-flash
# Interruptor de emergencia ("0" apaga AURA sin borrar la clave).
AURA_ENABLED=1
# Llamadas al modelo por día en toda la tienda, y límites por IP y por conversación.
AURA_DAILY_LIMIT=150
AURA_IP_HOURLY=20
AURA_IP_DAILY=60
AURA_MAX_MESSAGES=24
# Mientras el catálogo sea de demostración, AURA lo aclara al mostrar productos ("0" cuando sea real).
AURA_CATALOG_IS_DEMO=1
# Respaldo automático GRATUITO cuando el modelo principal está saturado (503). "0" lo desactiva.
AURA_FALLBACK_MODEL=gemini-3.6-flash
