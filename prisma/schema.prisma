generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  HOMBRE
  MUJER
  UNISEX
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  PSE
  BANK_TRANSFER
  CASH_DEPOSIT
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum AdminRole {
  OWNER
  ADMIN
}

/// Fuente de verdad de las categorías del catálogo. "Todo" NO es una categoría: es el filtro del catálogo.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String
  /// Inactiva = oculta en la tienda. Solo se puede desactivar si no tiene productos activos.
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  /// Imagen para la portada (opcional).
  imageUrl  String?
  createdAt DateTime  @default(now())
  products  Product[]
  @@index([active, sortOrder])
}

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  brand            String
  description      String
  priceCOP         Int
  compareAtPriceCOP Int?
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  gender           Gender
  isAccessory      Boolean     @default(false)
  images           String[]
  sizes            String[]
  stock            Int         @default(0)
  tags             String[]
  featured         Boolean     @default(false)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  orderItems       OrderItem[]
  variants         ProductVariant[]
  @@index([categoryId])
  @@index([featured])
  @@index([active])
}

/// Inventario por talla. Un producto con variantes usa SOLO el stock de sus variantes;
/// `Product.stock` queda como suma informativa (se actualiza desde el admin).
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  stock      Int         @default(0)
  orderItems OrderItem[]
  @@unique([productId, size])
  @@index([productId])
}

model Order {
  id               String        @id @default(cuid())
  publicCode       String        @unique
  status           OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod    PaymentMethod
  customerFullName String
  customerEmail    String
  customerPhone    String
  documentType     String
  documentNumber   String
  department       String
  city             String
  address          String
  notes            String?
  subtotalCOP      Int
  shippingCOP      Int
  totalCOP         Int
  trackingNumber   String?
  carrier          String?
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  items            OrderItem[]
  payments         Payment[]
  @@index([customerEmail, publicCode])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name        String
  size        String?
  unitPriceCOP Int
  quantity    Int
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?
  status      PaymentStatus @default(PENDING)
  amountCOP   Int
  proofUrl    String?
  rawPayload  Json?
  createdAt   DateTime      @default(now())
  @@index([orderId])
  @@index([providerRef])
}

/// Cuenta administrativa individual. Nunca se crea desde un registro público:
/// la primera se crea en /admin/setup (con la llave de arranque) y las demás las crea un OWNER.
model AdminUser {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String
  /// scrypt (node:crypto). Nunca texto plano.
  passwordHash      String
  role              AdminRole            @default(ADMIN)
  active            Boolean              @default(true)
  passwordChangedAt DateTime             @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  sessions          AdminSession[]
  resetTokens       AdminPasswordReset[]
  auditLogs         AdminAuditLog[]
}

/// Sesión revocable. La cookie lleva un token firmado; aquí solo se guarda su hash.
model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  @@index([adminId])
}

/// Token de recuperación de contraseña: un solo uso, caduca, se guarda solo su hash.
model AdminPasswordReset {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([adminId])
}

/// Registro de acciones administrativas importantes (quién, qué, cuándo).
model AdminAuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime   @default(now())
  @@index([createdAt])
  @@index([adminId])
  @@index([entityType, entityId])
}

/// Contadores de límite de intentos compartidos entre instancias (serverless).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
  @@index([resetAt])
}
