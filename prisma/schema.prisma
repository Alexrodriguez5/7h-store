generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  HOMBRE
  MUJER
  UNISEX
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CARD
  PSE
  BANK_TRANSFER
  CASH_DEPOSIT
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  FAILED
}

enum AdminRole {
  OWNER
  ADMIN
}

/// Fuente de verdad de las categorías del catálogo. "Todo" NO es una categoría: es el filtro del catálogo.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  label     String
  /// Inactiva = oculta en la tienda. Solo se puede desactivar si no tiene productos activos.
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  /// Imagen para la portada (opcional).
  imageUrl  String?
  createdAt DateTime  @default(now())
  products  Product[]

  @@index([active, sortOrder])
}

model Product {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  brand             String
  description       String
  priceCOP          Int
  compareAtPriceCOP Int?
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  gender            Gender
  isAccessory       Boolean          @default(false)
  images            String[]
  sizes             String[]
  stock             Int              @default(0)
  tags              String[]
  featured          Boolean          @default(false)
  active            Boolean          @default(true)
  /// Peso del producto empacado, en gramos (para calcular el envío). Vacío = 1 kg por defecto.
  weightGrams       Int?
  /// Medidas del paquete en cm (las piden las transportadoras para cotizar). Opcionales.
  lengthCm          Int?
  widthCm           Int?
  heightCm          Int?
  /// Ficha de información (todo opcional: lo que esté vacío no se muestra en la tienda).
  model             String?
  material          String?
  color             String?
  /// Origen CONFIRMADO por el administrador (p. ej. "Estados Unidos"). Vacío = no se afirma nada.
  origin            String?
  /// Estado del producto (p. ej. "Nuevo, con etiquetas").
  condition         String?
  /// Garantía y condiciones específicas del producto (además de la garantía legal).
  warranty          String?
  features          String[]         @default([])
  /// Etiquetas que el administrador CONFIRMA (ORIGINAL, IMPORTADO_USA, GARANTIA_FABRICANTE, EDICION_LIMITADA).
  badges            String[]         @default([])
  /// Video demostrativo opcional (YouTube, Vimeo o MP4 por https).
  videoUrl          String?
  /// Producto creado para una oferta personalizada: no se lista en la tienda y solo lo compra ese cliente.
  customOnly        Boolean          @default(false)
  createdAt         DateTime         @default(now())
  orderItems        OrderItem[]
  variants          ProductVariant[]
  reviews           Review[]
  media             MediaItem[]
  customOffer       CustomOffer?

  @@index([categoryId])
  @@index([featured])
  @@index([active])
}

/// Inventario por talla. Un producto con variantes usa SOLO el stock de sus variantes;
/// `Product.stock` queda como suma informativa (se actualiza desde el admin).
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  stock      Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId])
}

model Order {
  id               String           @id @default(cuid())
  publicCode       String           @unique
  status           OrderStatus      @default(PENDING_PAYMENT)
  paymentMethod    PaymentMethod
  customerFullName String
  customerEmail    String
  customerPhone    String
  documentType     String
  documentNumber   String
  department       String
  city             String
  address          String
  notes            String?
  subtotalCOP      Int
  shippingCOP      Int
  totalCOP         Int
  trackingNumber   String?
  carrier          String?
  /// Zona de envío aplicada y plazo estimado ("5 a 10 días hábiles") al crear el pedido.
  shippingZone     String?
  shippingEta      String?
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  items            OrderItem[]
  payments         Payment[]
  supportRequests  SupportRequest[]

  @@index([customerEmail, publicCode])
  @@index([status])
}

model OrderItem {
  id           String               @id @default(cuid())
  orderId      String
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product              @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name         String
  size         String?
  unitPriceCOP Int
  quantity     Int
  supportItems SupportRequestItem[]
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String?
  status      PaymentStatus @default(PENDING)
  amountCOP   Int
  proofUrl    String?
  rawPayload  Json?
  createdAt   DateTime      @default(now())

  @@index([orderId])
  @@index([providerRef])
}

/// Cuenta administrativa individual. Nunca se crea desde un registro público:
/// la primera se crea en /admin/setup (con la llave de arranque) y las demás las crea un OWNER.
model AdminUser {
  id                String               @id @default(cuid())
  email             String               @unique
  name              String
  /// scrypt (node:crypto). Nunca texto plano.
  passwordHash      String
  role              AdminRole            @default(ADMIN)
  active            Boolean              @default(true)
  passwordChangedAt DateTime             @default(now())
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  sessions          AdminSession[]
  resetTokens       AdminPasswordReset[]
  auditLogs         AdminAuditLog[]
  assignedSupport   SupportRequest[]
}

/// Sesión revocable. La cookie lleva un token firmado; aquí solo se guarda su hash.
model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

/// Token de recuperación de contraseña: un solo uso, caduca, se guarda solo su hash.
model AdminPasswordReset {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

/// Registro de acciones administrativas importantes (quién, qué, cuándo).
model AdminAuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@index([entityType, entityId])
}

/// Contadores de límite de intentos compartidos entre instancias (serverless).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Tarifas de envío por zona (grupo de departamentos), editables desde /admin/envios.
/// Costo = precio base (incluye hasta `baseWeightGrams`) + `extraPerKgCOP` por cada kg adicional o fracción.
model ShippingZone {
  id              String   @id @default(cuid())
  name            String
  departments     String[]
  priceCOP        Int
  baseWeightGrams Int      @default(1000)
  extraPerKgCOP   Int      @default(0)
  minDays         Int
  maxDays         Int
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, sortOrder])
}

// ───────────────────────────── Clientes ─────────────────────────────
// Un solo perfil por correo verificado; cada método de acceso es una "identidad" vinculada.
// La compra como invitado sigue igual: los pedidos se asocian al cliente por su correo VERIFICADO.

model Customer {
  id                  String              @id @default(cuid())
  /// Correo normalizado (minúsculas, sin espacios). Único.
  email               String              @unique
  emailVerifiedAt     DateTime?
  name                String
  phone               String?
  avatarUrl           String?
  /// Solo si el cliente creó contraseña (scrypt, como el panel).
  passwordHash        String?
  blockedAt           DateTime?
  /// Solicitud de supresión de datos (Ley 1581): la revisa el equipo; no borra pedidos (obligación contable).
  deletionRequestedAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  identities          CustomerIdentity[]
  sessions            CustomerSession[]
  addresses           CustomerAddress[]
  supportRequests     SupportRequest[]
  reviews             Review[]
  reviewVotes         ReviewVote[]
  productRequests     ProductRequest[]
  inquiries           Inquiry[]
  mediaItems          MediaItem[]
  communityPosts      CommunityPost[]
  communityComments   CommunityComment[]
  communityReactions  CommunityReaction[]
  communityReports    CommunityReport[]
  auraConversations   AuraConversation[]
}

model CustomerIdentity {
  id             String   @id @default(cuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// "password" | "google" | "email_otp"
  provider       String
  /// Para Google: el "sub" del token. Para correo: el correo normalizado.
  providerUserId String
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([customerId])
}

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// Códigos y enlaces de un solo uso (verificación, recuperación, OTP). Solo se guarda el hash.
model CustomerToken {
  id        String    @id @default(cuid())
  email     String
  /// "verify" | "reset" | "otp"
  purpose   String
  tokenHash String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String
  fullName     String
  phone        String
  department   String
  city         String
  address      String
  neighborhood String?
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([customerId])
}

// ───────────────────────── Solicitudes y garantías ─────────────────────────

enum SupportType {
  RETRACTO
  GARANTIA
  DEFECTUOSO
  DANADO_TRANSPORTE
  DIFERENTE
  INCOMPLETO
  NO_RECIBIDO
  CANCELACION
  REVERSION_PAGO
  CAMBIO_COMERCIAL
  OTRO
}

enum SupportStatus {
  RECIBIDA
  EN_REVISION
  INFO_SOLICITADA
  APROBADA
  NO_APROBADA
  ESPERANDO_DEVOLUCION
  PRODUCTO_RECIBIDO
  SOLUCION_EN_PROCESO
  REEMBOLSO_EN_PROCESO
  FINALIZADA
}

model SupportRequest {
  id              String               @id @default(cuid())
  /// Radicado: SOL-AAAA-000001
  code            String               @unique
  customerId      String
  customer        Customer             @relation(fields: [customerId], references: [id])
  orderId         String
  order           Order                @relation(fields: [orderId], references: [id])
  type            SupportType
  status          SupportStatus        @default(RECIBIDA)
  reason          String
  description     String
  contactEmail    String
  contactPhone    String?
  assignedAdminId String?
  assignedAdmin   AdminUser?           @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  /// Fecha límite de respuesta (orientativa, p. ej. 15 días hábiles para PQR).
  dueAt           DateTime?
  resolution      String?
  refundAmountCOP Int?
  refundReference String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           SupportRequestItem[]
  attachments     SupportAttachment[]
  events          SupportEvent[]

  @@index([customerId])
  @@index([orderId])
  @@index([status])
}

model SupportRequestItem {
  id          String         @id @default(cuid())
  requestId   String
  request     SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id])
  quantity    Int

  @@index([requestId])
}

/// Evidencias (fotos/video corto). Se guardan en la base de datos, nunca en enlaces públicos.
model SupportAttachment {
  id         String         @id @default(cuid())
  requestId  String
  request    SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName   String
  mime       String
  size       Int
  data       Bytes
  uploadedBy String
  createdAt  DateTime       @default(now())

  @@index([requestId])
}

/// Trazabilidad del caso: cambios de estado, mensajes y notas internas (visibleToCustomer=false).
model SupportEvent {
  id                String         @id @default(cuid())
  requestId         String
  request           SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// "created" | "status" | "message" | "note" | "assigned" | "refund" | "email_in"
  kind              String
  fromStatus        SupportStatus?
  toStatus          SupportStatus?
  body              String?
  /// "customer" | "admin" | "system"
  authorType        String
  adminId           String?
  visibleToCustomer Boolean        @default(true)
  createdAt         DateTime       @default(now())

  @@index([requestId, createdAt])
}

/// Registro de correos transaccionales (para reintentos y auditoría). No guarda el cuerpo completo.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  kind      String
  ref       String?
  status    String
  error     String?
  attempts  Int      @default(1)
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Contadores secuenciales (p. ej. radicados por año).
model Counter {
  key   String @id
  value Int    @default(0)
}

// ═════════════ 7H EXPERIENCE: contenido de clientes (todo nuevo; no modifica tablas existentes) ═════════════

/// Estado de moderación de lo que publican los clientes. Las reseñas y la galería no se muestran hasta quedar APROBADA.
enum ModerationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  OCULTA
}

/// Reseña de un producto. `verified` lo calcula SOLO el servidor (pedido pagado del producto con el correo del cliente).
model Review {
  id             String           @id @default(cuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating         Int
  title          String?
  body           String
  /// Nombre público (alias o nombre de pila con inicial). Nunca el correo.
  displayName    String
  verified       Boolean          @default(false)
  status         ModerationStatus @default(PENDIENTE)
  moderationNote String?
  helpfulCount   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  photos         ReviewPhoto[]
  votes          ReviewVote[]

  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status, createdAt])
}

/// Foto de una reseña, en el bucket PRIVADO de Supabase Storage. Se sirve por /media solo si la reseña está aprobada.
model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  path      String
  mime      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reviewId])
}

model ReviewVote {
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([reviewId, customerId])
}

enum ProductRequestStatus {
  NUEVA
  EN_REVISION
  COTIZANDO
  DISPONIBLE
  NO_DISPONIBLE
  FINALIZADA
  BUSCANDO_PROVEEDORES
  PROPUESTA_PREPARADA
  PROPUESTA_ENVIADA
  ESPERANDO_CLIENTE
  ACEPTADA
  RECHAZADA
  CONVERTIDA
  CERRADA
}

/// Tipo de precio de una alternativa: nunca se presenta una estimación como precio definitivo.
enum AlternativePriceKind {
  ESTIMADO
  COTIZADO
  FINAL
}

enum AlternativeStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
}

enum CustomOfferStatus {
  ACTIVA
  USADA
  VENCIDA
  REVOCADA
}

/// "Tú lo buscas. Nosotros lo exploramos": producto que un cliente quiere que traigamos. No exige cuenta.
model ProductRequest {
  id          String               @id @default(cuid())
  /// Radicado: BUS-AAAA-000001 (históricos) o BUS-XXXXXX aleatorio (nuevos).
  code        String               @unique
  customerId  String?
  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String
  email       String
  productName String
  brand       String?
  model       String?
  url         String?
  imagePath   String?
  imageMime   String?
  budgetCOP   Int?
  comments    String?
  status      ProductRequestStatus @default(NUEVA)
  adminReply  String?
  repliedAt   DateTime?
  /// Producto del catálogo creado a partir de esta solicitud (si se decidió traerlo).
  productId   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // ── AURA · Búsqueda personalizada (todo opcional: se admite información parcial) ──
  phone           String?
  color           String?
  size            String?
  features        String?
  referenceStore  String?
  /// Enlaces de referencia del cliente (se tratan como texto, el servidor nunca los visita).
  links           String[]             @default([])
  /// Lo que escribió el cliente, tal cual. El equipo edita los campos estructurados, nunca esto.
  originalText    String?
  /// Canal de origen: "formulario", "asistente", "cuenta", "portada".
  source          String?
  assignedAdminId String?
  /// Motivo de cierre o de no disponibilidad (para la analítica).
  closeReason     String?
  firstResponseAt DateTime?
  images          RequestImage[]
  events          RequestEvent[]
  alternatives    RequestAlternative[]
  accessTokens    RequestAccessToken[]
  offers          CustomOffer[]

  // ── AURA conversacional (Gemini) ──
  /// Resumen que AURA preparó y el cliente confirmó (sin datos personales).
  auraSummary        String?
  /// Prioridad sugerida por AURA: "alta" | "normal" | "baja". El equipo decide.
  auraPriority       String?
  /// Datos que el cliente no supo o no dio (se muestran como "Pendiente").
  auraPending        String[]          @default([])
  auraConversationId String?           @unique
  auraConversation   AuraConversation? @relation(fields: [auraConversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([assignedAdminId])
}

/// Conversación con AURA. La identidad del cliente vive aquí (servidor); nunca se envía al modelo.
model AuraConversation {
  id           String          @id @default(cuid())
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Hash de la IP (para límites); nunca la IP en claro.
  ipHash       String
  status       String          @default("abierta")
  /// Borrador de solicitud que AURA preparó y espera la confirmación del cliente (JSON validado).
  draft        Json?
  messageCount Int             @default(0)
  tokensIn     Int             @default(0)
  tokensOut    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     AuraMessage[]
  request      ProductRequest?

  @@index([createdAt])
  @@index([customerId])
}

/// Mensaje de la conversación, ya filtrado (lo que se guarda es lo mismo que pudo ver el modelo).
model AuraMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   AuraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "user" | "model" | "system" (respuesta fija del sistema, NO generada por IA)
  role           String
  text           String
  /// Herramientas usadas en este turno (nombres) y si hubo datos privados filtrados.
  tools          String[]         @default([])
  redacted       Boolean          @default(false)
  attachments    Int              @default(0)
  tokensIn       Int              @default(0)
  tokensOut      Int              @default(0)
  /// Si falló la IA: "quota" | "error" | "timeout" | "unconfigured" | "privacy"
  errorKind      String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

/// Fotos o capturas de referencia de una solicitud (bucket privado; las ve el cliente dueño y el equipo).
model RequestImage {
  id        String         @id @default(cuid())
  requestId String
  request   ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  path      String
  mime      String
  position  Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([requestId])
}

/// Historial de la solicitud: cambios de estado, mensajes y notas INTERNAS (internal = nunca se muestran al cliente).
model RequestEvent {
  id         String                @id @default(cuid())
  requestId  String
  request    ProductRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// "status" | "message" | "note" | "proposal" | "acceptance" | "rejection" | "offer" | "edit" | "assign"
  kind       String
  fromStatus ProductRequestStatus?
  toStatus   ProductRequestStatus?
  body       String?
  internal   Boolean               @default(false)
  /// "customer" | "admin" | "system"
  authorType String
  adminId    String?
  createdAt  DateTime              @default(now())

  @@index([requestId, createdAt])
}

/// Alternativa preparada por el equipo para una solicitud (no necesita existir en el catálogo).
model RequestAlternative {
  id               String               @id @default(cuid())
  requestId        String
  request          ProductRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Número de propuesta en la que se envió (permite nuevas revisiones sin perder historial).
  round            Int                  @default(1)
  position         Int                  @default(0)
  name             String
  brand            String?
  model            String?
  imageUrl         String?
  description      String?
  features         String[]             @default([])
  referenceUrl     String?
  priceKind        AlternativePriceKind @default(ESTIMADO)
  priceCOP         Int?
  extraCostsCOP    Int?
  shippingCOP      Int?
  availability     String?
  deliveryEstimate String?
  warranty         String?
  validUntil       DateTime?
  /// Observaciones visibles para el cliente.
  notes            String?
  /// Proveedor, costos y notas confidenciales: SOLO para el equipo.
  internalNotes    String?
  recommended      Boolean              @default(false)
  status           AlternativeStatus    @default(BORRADOR)
  sentAt           DateTime?
  respondedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  offers           CustomOffer[]

  @@index([requestId, round])
}

/// Enlace seguro para que un cliente SIN cuenta vea su solicitud y propuesta (solo se guarda el hash; vence y se puede revocar).
model RequestAccessToken {
  id        String         @id @default(cuid())
  requestId String
  request   ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tokenHash String         @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([requestId])
}

/// Oferta personalizada temporal: un producto privado (no sale en el catálogo) que solo puede comprar ese cliente
/// por el checkout normal. La venta se considera concretada solo cuando el pedido queda pagado.
model CustomOffer {
  id            String             @id @default(cuid())
  requestId     String
  request       ProductRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  alternativeId String
  alternative   RequestAlternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  productId     String             @unique
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerEmail String
  priceCOP      Int
  expiresAt     DateTime
  status        CustomOfferStatus  @default(ACTIVA)
  orderId       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([requestId])
  @@index([customerEmail])
}

enum InquiryTopic {
  DISPONIBILIDAD
  TALLAS
  CARACTERISTICAS
  SOLICITUD_ESPECIAL
  ENVIOS
  PEDIDOS
  GARANTIAS
  OTRO
}

enum InquiryStatus {
  ABIERTA
  RESPONDIDA
  CERRADA
}

/// "Habla con 7H STORE": consulta persistente con respuestas de la tienda (no es un chat simulado).
model Inquiry {
  id          String           @id @default(cuid())
  /// Radicado: CON-AAAA-000001
  code        String           @unique
  /// Hash del secreto del enlace con el que un invitado ve su conversación.
  accessHash  String
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String
  email       String
  topic       InquiryTopic
  subject     String
  productSlug String?
  status      InquiryStatus    @default(ABIERTA)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    InquiryMessage[]

  @@index([status, updatedAt])
  @@index([email])
}

model InquiryMessage {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  /// "customer" o "admin"
  author    String
  adminId   String?
  body      String
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

enum MediaKind {
  IMAGEN
  VIDEO
}

/// "Así se vive 7H": fotos y videos de la tienda o de clientes. Los de clientes exigen autorización de uso público.
model MediaItem {
  id          String           @id @default(cuid())
  kind        MediaKind        @default(IMAGEN)
  /// "store" (subido por la tienda) o "customer"
  source      String
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Ruta en el bucket privado (fotos de clientes) o URL https (contenido de la tienda o video).
  path        String
  mime        String?
  caption     String?
  displayName String?
  /// Autorización expresa para publicar (obligatoria en contenido de clientes).
  consentAt   DateTime?
  status      ModerationStatus @default(PENDIENTE)
  featured    Boolean          @default(false)
  /// El cliente pidió retirarlo: deja de mostrarse de inmediato.
  withdrawnAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
}

enum CommunityCategory {
  RECOMENDACIONES
  TECNOLOGIA
  MODA_ESTILO
  PRODUCTOS_QUE_BUSCAMOS
  NOVEDADES
  PREGUNTAS
}

/// Comunidad 7H (versión básica): publicaciones de clientes con sesión, con reportes y moderación.
model CommunityPost {
  id          String              @id @default(cuid())
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category    CommunityCategory
  title       String
  body        String
  displayName String
  imagePath   String?
  imageMime   String?
  status      ModerationStatus    @default(APROBADA)
  pinned      Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  comments    CommunityComment[]
  reactions   CommunityReaction[]
  reports     CommunityReport[]

  @@index([status, createdAt])
  @@index([category, status])
}

model CommunityComment {
  id          String             @id @default(cuid())
  postId      String
  post        CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Respuesta oficial de 7H STORE (escrita desde el panel).
  adminId     String?
  parentId    String?
  parent      CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CommunityComment[] @relation("CommentReplies")
  displayName String
  body        String
  status      ModerationStatus   @default(APROBADA)
  createdAt   DateTime           @default(now())
  reports     CommunityReport[]

  @@index([postId, createdAt])
}

model CommunityReaction {
  postId     String
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@id([postId, customerId])
}

model CommunityReport {
  id         String            @id @default(cuid())
  postId     String?
  post       CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason     String
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([resolvedAt])
}
